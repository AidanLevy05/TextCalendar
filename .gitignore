# Environment files
.env
.env.*
!.env.example
*.env
!example.env

# Real config (config.example.toml IS committed; config.toml is NOT)
config.toml
config.*.toml
!config.example.toml
/config/

# Google OAuth: client secrets, downloaded credentials, minted tokens
client_secret*.json
client_secrets*.json
credentials.json
token.json
token.pickle
*token*.json
!package.json
!package-lock.json
!tsconfig.json
service-account*.json
*-service-account.json
gcp-*.json

